# TWIN Node Alpha - main runtime configuration.
# Loaded as env_file by both twin-bootstrap-alpha and twin-node-alpha.
# Only difference vs twin/beta/node.env: TWIN_MY_SQL_HOST.

# Web server
TWIN_PORT=3000
TWIN_HOST=0.0.0.0
TWIN_DEBUG=true
TWIN_STORAGE_FILE_ROOT=/var/lib/twin

# MySQL
TWIN_MY_SQL_HOST=db-alpha
TWIN_MY_SQL_PORT=3306
TWIN_MY_SQL_USER=twin
TWIN_MY_SQL_PASSWORD=twin
TWIN_MY_SQL_DATABASE=twin

# IOTA testnet
TWIN_IOTA_NODE_ENDPOINT=https://api.testnet.iota.cafe
TWIN_IOTA_FAUCET_ENDPOINT=https://faucet.testnet.iota.cafe
TWIN_IOTA_EXPLORER_ENDPOINT=https://explorer.iota.org/
TWIN_IOTA_NETWORK=testnet
TWIN_IOTA_COIN_TYPE=4218

# Storage connectors
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE=mysql
TWIN_BLOB_STORAGE_CONNECTOR_TYPE=file
TWIN_BLOB_STORAGE_ENABLE_ENCRYPTION=true

# Component connectors
TWIN_LOGGING_CONNECTOR=console
TWIN_VAULT_CONNECTOR=entity-storage
TWIN_EVENT_BUS_CONNECTOR=local
# TWIN_TELEMETRY_CONNECTOR=entity-storage  # disabled: node observability (system/process metrics), not a demo feature. Drove memory growth + log churn (metrics collector 60s x maxHistory 1440). Re-enable for ops, not the demo.
TWIN_FAUCET_CONNECTOR=iota
TWIN_WALLET_CONNECTOR=iota
TWIN_NFT_CONNECTOR=iota
# T-323: twin-node next.48 wires the immutable-proof component to a notarization
# connector. immutable-proof is required here because TWIN_DATASPACE_ENABLED=true,
# so the connector must be registered or the engine aborts with "Instance type
# not found for notarizationConnector". iota reuses the shared IOTA dltConfig
# (same as nft), keeping immutable proofs anchored on testnet.
TWIN_NOTARIZATION_CONNECTOR=iota
TWIN_IDENTITY_CONNECTOR=iota
TWIN_IDENTITY_RESOLVER_CONNECTOR=iota
TWIN_IDENTITY_PROFILE_CONNECTOR=entity-storage
TWIN_ATTESTATION_CONNECTOR=nft

# Authentication (required for bootstrap node-admin-user + runtime login)
TWIN_AUTH_PROCESSOR_TYPE=entity-storage
TWIN_AUTH_ADMIN_PROCESSOR_TYPE=entity-storage

# Feature flags - Phase 2 scope
# T-314 / T-323: multi-tenant mode required by tenant-create / user-create (node-set-tenant removed in twin-node next.48)
# in the granular bootstrap chain. The demo uses one logical tenant per node
# (alpha + beta), but the CLI commands themselves are only available when this
# is enabled.
TWIN_TENANT_ENABLED=true
TWIN_HEALTH_ENABLED=true
TWIN_DATA_PROCESSING_ENABLED=true
TWIN_DATA_CONVERTER_CONNECTORS=json,xml
TWIN_DATA_EXTRACTOR_CONNECTORS=json-path
TWIN_AUDITABLE_ITEM_GRAPH_ENABLED=true
TWIN_AUDITABLE_ITEM_STREAM_ENABLED=true
TWIN_DOCUMENT_MANAGEMENT_ENABLED=true
# TWIN_TRUST_ENABLED removed in 0.0.3-next.35 (auto-enabled when dataspace/
# rights-management/synchronised-storage is on). Trust verifier config still respected.
TWIN_TRUST_VERIFIERS=jwt-verifiable-credential
TWIN_FEDERATED_CATALOGUE_ENABLED=true
TWIN_TASK_SCHEDULER_ENABLED=true

# Feature flags - Phase 3 (T-317): DSP stack enabled so /catalog/request and
# /dataspace-control-plane/app-datasets are mounted, and orgs registered as
# DCAT datasets federate to the peer node.
# TWIN_DATA_SPACE_CONNECTOR_ENABLED was renamed to TWIN_DATASPACE_ENABLED in 0.0.3-next.24.
# T-423 (node 0.9.0): strict env validation. Removed TWIN_VERIFIABLE_STORAGE_CONNECTOR
# (verifiable-storage dropped; immutable-proof uses the notarization connector),
# TWIN_BACKGROUND_TASKS_ENABLED (task scheduler already forced on above),
# TWIN_RIGHTS_MANAGEMENT_ENABLED (auto-enabled when dataspace is on), and
# TWIN_DATASPACE_PEER_NODES (0.9.0 addresses DSP peers dynamically).
TWIN_DATASPACE_ENABLED=true
TWIN_DATASPACE_DATA_PLANE_PATH=dataspace-data-plane
