# TWIN Node Alpha - one-time bootstrap configuration.
# Mounted into the bootstrap container at /app/.env.bootstrap and loaded via
# `node src/index.js bootstrap-legacy --load-env=.env.bootstrap`.
# Demo/testnet credentials only.
TWIN_FEATURES=node-identity,node-admin-user,node-wallet
# Values are quoted: the '#' in the password would otherwise be parsed as a comment.
TWIN_ADMIN_USER_NAME="admin@alpha"
TWIN_ADMIN_USER_PASSWORD="TwinAlpha#2026!Demo"
