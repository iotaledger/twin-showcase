{
  "name": "trade-corridor-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:twin && vite build --outDir ../server/public",
    "dev:client": "vite",
    "node:alpha": "node server/index.js --port=4000 --id=alpha --name='Node Alpha' --peer=ws://localhost:4001",
    "node:beta": "node server/index.js --port=4001 --id=beta --name='Node Beta' --peer=ws://localhost:4000",
    "start": "npm run build && concurrently \"npm run node:alpha\" \"npm run node:beta\"",
    "dev": "npm run build && concurrently \"npm run node:alpha\" \"npm run node:beta\"",
    "proxy": "node server/proxy.js",
    "demo": "npm run build && concurrently \"npm run node:alpha\" \"npm run node:beta\" \"npm run proxy\"",
    "build:twin": "tsc -p server/twin/tsconfig.json",
    "twin:up": "bash scripts/twin/up.sh",
    "twin:start": "bash scripts/twin/up.sh",
    "twin:down": "bash scripts/twin/down.sh",
    "twin:stop": "bash scripts/twin/down.sh",
    "twin:bootstrap": "bash scripts/twin/bootstrap.sh",
    "twin:reset": "bash scripts/twin/reset.sh",
    "twin:status": "bash scripts/twin/status.sh",
    "twin:logs": "bash scripts/twin/logs.sh",
    "twin:seed": "node scripts/seed-twin-nodes.js",
    "twin:reseed": "bash scripts/twin/reseed.sh",
    "twin:wallets:create": "node scripts/twin/wallets.mjs create",
    "twin:wallets:show": "node scripts/twin/wallets.mjs show",
    "twin:wallets:reveal": "node scripts/twin/wallets.mjs reveal",
    "twin:wallets:balance": "node scripts/twin/wallets.mjs balance",
    "twin:wallets:rekey": "node scripts/twin/wallets.mjs rekey",
    "twin:provision-orgs": "node scripts/twin/wallets.mjs provision-orgs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iota/iota-sdk": "^1.14.0",
    "@scure/bip39": "^2.2.0",
    "@twin.org/api-models": "0.9.0",
    "@twin.org/attestation-rest-client": "0.9.0",
    "@twin.org/auditable-item-graph-rest-client": "0.9.0",
    "@twin.org/auditable-item-stream-rest-client": "0.9.0",
    "@twin.org/blob-storage-rest-client": "0.9.0",
    "@twin.org/dataspace-control-plane-rest-client": "0.9.0",
    "@twin.org/dataspace-data-plane-rest-client": "0.9.0",
    "@twin.org/dataspace-models": "0.9.0",
    "@twin.org/document-management-rest-client": "0.9.0",
    "@twin.org/identity-rest-client": "0.9.0",
    "@twin.org/immutable-proof-rest-client": "0.9.0",
    "@twin.org/nft-rest-client": "0.9.0",
    "@twin.org/notarization-rest-client": "0.9.0",
    "@twin.org/rights-management-rest-client": "0.9.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.3.0",
    "helmet": "^8.2.0",
    "lucide-react": "^0.383.0",
    "multer": "^2.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitejs/plugin-react": "^5.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "esbuild": "0.28.1"
  }
}
