# =============================================================================
# Trade Corridor Demo — environment variable reference
# =============================================================================
# Copy this file to `.env` (`cp .env.example .env`, or `.envrc` for direnv
# users) and set WALLET_PASSPHRASE to a strong passphrase of your own. The
# three uncommented variables below (CONFIG_FILE, ADAPTER_MODE,
# WALLET_PASSPHRASE) are the defaults for docker mode with the customs
# corridor; every other variable is commented out and falls back to its
# default. `.env` is gitignored; this `.env.example` is the only committed
# copy and serves as documentation.
#
# Nothing in server/ or scripts/ loads `.env` (no dotenv). Export it into
# your shell before running npm scripts: `set -a; source ./.env; set +a`.
# docker compose reads `.env` only for ${...} interpolation in the compose
# files (TWIN_MYSQL_* in docker-compose.twin.yml, CONFIG_FILE,
# PUBLIC_BASE_URL and WEBAPP_IMAGE in docker-compose.deploy.yml).
#
# Conventions:
#   - Variables marked "required" must be set explicitly.
#   - Variables marked "optional" fall back to a sane default.
#   - Variables marked "container-only" live in twin/<node>/node.env or
#     twin/<node>/bootstrap.env and are passed to the TWIN node docker
#     image — they should NOT be set in your shell environment.

# ──────────────────────────────────────────────────────────────────────────
# Corridor selection
# ──────────────────────────────────────────────────────────────────────────

# Optional. Path to the corridor JSON config used by the demo server and
# the TWIN seeder. A set value is resolved from the current working directory.
# Defaults differ per entry point, so set it explicitly for docker mode:
#   - demo server and twin:seed (server/config.js): configs/vietnam-us-customs.json
#     (twin:seed logs "vietnam-us.json" as its label, but loads the customs file)
#   - twin:provision-orgs (scripts/twin/wallets.mjs) and the demo containers in
#     docker-compose.deploy.yml: configs/vietnam-us.json
# Switching corridors: see docs/running-the-demo.md#switching-corridors
# (twin:reseed for a clean switch; provision + seed alone mixes the corridors).
#
# Examples: configs/vietnam-us-customs.json, configs/vietnam-us.json,
#           configs/vietnam-eu.json, configs/cambodia-eu.json,
#           configs/adapt-africa.json
#
CONFIG_FILE=configs/vietnam-us-customs.json


# ──────────────────────────────────────────────────────────────────────────
# Adapter mode
# ──────────────────────────────────────────────────────────────────────────

# Optional. Which adapter implementation each demo server uses.
#   simulated: in-memory only, no network, no IOTA dependencies.
#   docker:    REST calls to local TWIN nodes at http://localhost:3000/3001
#              (default, server/adapter/index.js ADAPTER_DEFAULT_MODE).
#   hosted:    REST calls to remote hosted TWIN nodes (TWIN_<NODE>_URL required).
#
# Because the default is docker, a plain `npm run demo` without running TWIN
# nodes needs ADAPTER_MODE=simulated: set it here, or override it for one
# run with `ADAPTER_MODE=simulated npm run demo`. For real TWIN nodes see README
# §"Running in docker mode (real TWIN nodes)", docs/running-the-demo.md and
# docs/wallet-funding-workflow.md.
#
ADAPTER_MODE=docker


# ──────────────────────────────────────────────────────────────────────────
# Wallet management (two-stage bootstrap)
# ──────────────────────────────────────────────────────────────────────────

# Required for: twin:wallets:create / reveal / rekey / bootstrap --stage=anchor
# Required for: twin:provision-orgs and twin:reseed.
# Required on a deploy host: the CI secret or SECRETS_FILE (docs/deployment.md).
#
# Strong passphrase of your choice, used to derive the AES-256-GCM encryption
# key for data/wallets.enc.json (PBKDF2-SHA256, 600,000 rounds), which
# twin:wallets:create writes and .gitignore keeps out of the repository.
# Store it in a password manager — the encrypted bundle is unrecoverable
# without it.
# Use twin:wallets:rekey to rotate.
#
# Replace the demo value with a passphrase of your own before the first
# twin:wallets:create. Keep single quotes around it if it contains shell
# characters (WALLET_PASSPHRASE='...'), and avoid whitespace if the same
# passphrase is used by the deploy pipeline.
WALLET_PASSPHRASE=twin-test

# Required ONLY for: twin:wallets:rekey
# The current passphrase to rotate AWAY from. Use together with a NEW
# value in WALLET_PASSPHRASE to perform the rotation.
#
# WALLET_PASSPHRASE_OLD=current-passphrase

# Optional. Moves the encrypted wallet bundle (default: data/wallets.enc.json,
# resolved from the repo root). The addresses file (wallet-addresses.json for
# a bundle named wallets.enc.json) and tenant-state.json are written next to
# it, but the demo server, twin:seed, twin:status, twin:reset and the deploy
# containers read only data/, so use it only to keep a second wallet set aside.
#
# WALLET_BUNDLE_PATH=/mnt/secrets/twin/wallets.enc.json

# Optional. IOTA transferred to each org wallet by twin:provision-orgs.
# Default: 2 (server/twin/compat/index.js ORG_FUNDING_IOTA_DEFAULT). Whole
# IOTA only (a value such as 1.5 makes every twin:wallets:* command fail).
# Must be greater than 1, because each on-chain op reserves a 1-IOTA gas budget.
#
# ORG_FUNDING_IOTA=2


# ──────────────────────────────────────────────────────────────────────────
# Demo server (Node Alpha + Node Beta)
# ──────────────────────────────────────────────────────────────────────────
# These also accept CLI flags (--port, --id, --name, --peer). Env vars take
# precedence over the CLI flags (server/store.js). Leave them unset for `npm
# run demo`: the package.json scripts pass per-node flags, and an exported
# PORT or NODE_ID would override both nodes with the same value.

# Optional. HTTP port for the demo server. The WebSocket server (browser push
# and P2P peering) shares this port. Default: 4000. The node:alpha / node:beta
# scripts pass --port=4000 / --port=4001.
# PORT=4000

# Obsolete. Not used for listening: WebSockets attach to the HTTP server on
# PORT (peers connect to PEER_URL + '/peer'). The value (default 4010, also
# --ws) is only echoed as wsPort by GET /api/node.
# WS_PORT=4010

# Optional. Node identifier. Default: 'alpha'. Accepted: 'alpha' | 'beta'.
# NODE_ID=alpha

# Optional. Human-readable node name shown in the UI. Default: 'Node Alpha'.
# NODE_NAME=Node Alpha

# Optional. WebSocket URL of the peer node for P2P sync. Default: null
# (single-node mode). The package.json scripts wire alpha → ws://localhost:4001
# and beta → ws://localhost:4000.
# PEER_URL=ws://localhost:4001


# ──────────────────────────────────────────────────────────────────────────
# Proxy (cookie-based routing in front of both demo servers)
# ──────────────────────────────────────────────────────────────────────────

# Optional. HTTP port the proxy listens on. Default: 4002.
# PROXY_PORT=4002

# Optional. Upstream Alpha demo server host:port. Default: 127.0.0.1:4000.
# ALPHA_HOST=127.0.0.1
# ALPHA_PORT=4000

# Optional. Upstream Beta demo server host:port. Default: 127.0.0.1:4001.
# BETA_HOST=127.0.0.1
# BETA_PORT=4001


# ──────────────────────────────────────────────────────────────────────────
# TWIN node connection (docker / hosted adapter)
# ──────────────────────────────────────────────────────────────────────────
# Per-node overrides, <NODE> = ALPHA or BETA (server/adapter/index.js).

# Required ONLY when ADAPTER_MODE=hosted (there is no TWIN_NODE_URL). URL of
# the remote hosted TWIN node for that demo server. Must NOT be localhost
# (use ADAPTER_MODE=docker for that). Optional in docker mode, where the
# default is http://localhost:3000 (alpha) / http://localhost:3001 (beta).
#
# TWIN_ALPHA_URL=https://twin-alpha.example.com
# TWIN_BETA_URL=https://twin-beta.example.com

# Optional. Node admin login. Default email: admin@<node>. Default password:
# the demo value in server/adapter/index.js, which matches
# twin/<node>/bootstrap.env.
# TWIN_ALPHA_EMAIL=admin@alpha
# TWIN_ALPHA_PASSWORD=change-me

# Optional. Tenant api-key and encrypted tenant token. Default: read from
# data/tenant-state.json (written by twin:bootstrap -- --stage=anchor).
# TWIN_ALPHA_API_KEY=
# TWIN_ALPHA_ENC_TENANT_TOKEN=


# ──────────────────────────────────────────────────────────────────────────
# Demo server security and public URLs
# ──────────────────────────────────────────────────────────────────────────

# Optional. HMAC key for the signed login cookie (server/middleware/session.js).
# Default: twin-demo-session-secret-change-me. Set a random value on any
# public deploy, otherwise session cookies can be forged.
# SESSION_SECRET=change-me

# Optional. Comma-separated tokens accepted in the x-service-token header by
# the system-to-system verify API (server/routes/verify-api.js, /api/verify).
# Default: demo-customs-integration. Replace it on any public deploy.
# VERIFY_API_TOKENS=token-one,token-two

# Optional. Base URL baked into document and shipment QR codes
# (server/qr.js). Default: http://localhost:4002 (the proxy). The seed
# embeds it in the generated PDFs, so use the same value for twin:seed and
# for the running demo, or the server-generated PDFs no longer match the
# seeded blobs and hashes. docker-compose.deploy.yml passes an unset value as
# an empty string, which makes the QR URLs relative, so set it on any deploy.
# PUBLIC_BASE_URL=https://demo.example.com

# Optional. Set to exactly 1 to enable the login brute-force limiter
# (server/middleware/security.js). It applies to /api/login only. Default: off.
# RATE_LIMIT_ENABLED=1


# ──────────────────────────────────────────────────────────────────────────
# TWIN-node MySQL (docker-compose.twin.yml)
# ──────────────────────────────────────────────────────────────────────────

# Optional. Passwords for the two MySQL containers backing the TWIN nodes.
# Defaults keep local dev zero-config; SET STRONG VALUES ON ANY
# DEPLOY HOST, in a `.env` next to docker-compose.twin.yml, BEFORE the first
# `up` — MySQL only honours them on first init of an empty data volume.
# The ports are bound to 127.0.0.1 either way; these are defence in depth.
# TWIN_MYSQL_ROOT_PASSWORD=change-me
# TWIN_MYSQL_PASSWORD=change-me


# ──────────────────────────────────────────────────────────────────────────
# Diagnostics
# ──────────────────────────────────────────────────────────────────────────

# Optional. When set (any truthy value), wallets.mjs prints full stack
# traces on errors instead of the clean single-line FATAL message.
# DEBUG=1

# Leftover. server/index.js skips listen, the WebSocket server and the anchor
# backfill when VERCEL is set, a branch for a Vercel deployment that this
# repository no longer configures. Do not set it.
# VERCEL=1


# ──────────────────────────────────────────────────────────────────────────
# Container-only — TWIN node image
# ──────────────────────────────────────────────────────────────────────────
# The following variables are consumed by the `twinfoundation/twin-node`
# docker image and live in twin/alpha/node.env, twin/beta/node.env,
# twin/<node>/bootstrap.env. They are NOT read by Node.js code in this
# repository — listed here only as a pointer for operators editing those
# files.
#
#   TWIN_PORT, TWIN_HOST, TWIN_DEBUG
#   TWIN_STORAGE_FILE_ROOT
#   TWIN_MY_SQL_HOST, TWIN_MY_SQL_PORT, TWIN_MY_SQL_USER,
#   TWIN_MY_SQL_PASSWORD, TWIN_MY_SQL_DATABASE
#   TWIN_IOTA_NODE_ENDPOINT, TWIN_IOTA_FAUCET_ENDPOINT,
#   TWIN_IOTA_EXPLORER_ENDPOINT, TWIN_IOTA_NETWORK, TWIN_IOTA_COIN_TYPE
#   TWIN_ENTITY_STORAGE_CONNECTOR_TYPE, TWIN_BLOB_STORAGE_CONNECTOR_TYPE,
#   TWIN_BLOB_STORAGE_ENABLE_ENCRYPTION
#   TWIN_LOGGING_CONNECTOR, TWIN_VAULT_CONNECTOR, TWIN_EVENT_BUS_CONNECTOR,
#   TWIN_FAUCET_CONNECTOR, TWIN_WALLET_CONNECTOR, TWIN_NFT_CONNECTOR,
#   TWIN_NOTARIZATION_CONNECTOR, TWIN_IDENTITY_CONNECTOR,
#   TWIN_IDENTITY_RESOLVER_CONNECTOR, TWIN_IDENTITY_PROFILE_CONNECTOR,
#   TWIN_ATTESTATION_CONNECTOR
#   TWIN_TELEMETRY_CONNECTOR       (commented out in node.env: disabled)
#   TWIN_TRUST_ENABLED (removed in next.35) and
#   TWIN_DATA_SPACE_CONNECTOR_ENABLED (renamed TWIN_DATASPACE_ENABLED in
#   next.24) appear in node.env only as comments
#   TWIN_AUTH_PROCESSOR_TYPE, TWIN_AUTH_ADMIN_PROCESSOR_TYPE
#   TWIN_HEALTH_ENABLED, TWIN_DATA_PROCESSING_ENABLED,
#   TWIN_DATA_CONVERTER_CONNECTORS, TWIN_DATA_EXTRACTOR_CONNECTORS,
#   TWIN_AUDITABLE_ITEM_GRAPH_ENABLED, TWIN_AUDITABLE_ITEM_STREAM_ENABLED,
#   TWIN_DOCUMENT_MANAGEMENT_ENABLED, TWIN_TRUST_VERIFIERS,
#   TWIN_FEDERATED_CATALOGUE_ENABLED, TWIN_TASK_SCHEDULER_ENABLED,
#   TWIN_DATASPACE_ENABLED, TWIN_DATASPACE_DATA_PLANE_PATH
#   Removed for node 0.9.0 (its strict env validation rejects unknown
#   TWIN_* keys, so do not add them back): TWIN_VERIFIABLE_STORAGE_CONNECTOR,
#   TWIN_BACKGROUND_TASKS_ENABLED, TWIN_RIGHTS_MANAGEMENT_ENABLED,
#   TWIN_DATASPACE_PEER_NODES
#   TWIN_FEATURES                  (bootstrap.env only — legacy single-shot)
#   TWIN_ADMIN_USER_NAME, TWIN_ADMIN_USER_PASSWORD   (bootstrap.env only)
#   TWIN_TENANT_ENABLED            (=true, required by the granular CLI
#                                   chain — `user-create` rejects without
#                                   `--tenant-id` and `tenant-create` rejects
#                                   when this flag is off. The demo uses one
#                                   logical tenant per node, but the CLI
#                                   commands themselves are only available in
#                                   multi-tenant mode.)
#   TWIN_NODE_MNEMONIC, TWIN_ORGANIZATION_MNEMONIC   (not set in node.env or
#                                                     bootstrap.env: the
#                                                     anchor passes the mnemonic
#                                                     as a CLI flag to each
#                                                     `identity-create` call.)
